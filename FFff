import { useState } from 'react';
import { SafeAreaView, TextInput, FlatList, Text, View, Pressable, StyleSheet } from 'react-native';

// Заглушка данных (будто это пришло от API)
const MOCK_PLAYERS = [
  { id: '1', nickname: 'AimStar', region: 'KZ' },
  { id: '2', nickname: 'FlashGod', region: 'RU' },
  { id: '3', nickname: 'MidKing', region: 'KZ' },
];

export default function App() {
  const [query, setQuery] = useState('');
  const [players, setPlayers] = useState(MOCK_PLAYERS);

  function search() {
    if (!query) return setPlayers(MOCK_PLAYERS);
    setPlayers(
      MOCK_PLAYERS.filter(p =>
        p.nickname.toLowerCase().includes(query.toLowerCase())
      )
    );
  }

  return (
    <SafeAreaView style={styles.container}>
      <Text style={styles.title}>Поиск игроков</Text>
      <TextInput
        placeholder="Введите ник или роль"
        value={query}
        onChangeText={setQuery}
        style={styles.input}
      />
      <Pressable style={styles.button} onPress={search}>
        <Text style={styles.buttonText}>Искать</Text>
      </Pressable>

      <FlatList
        data={players}
        keyExtractor={(p) => p.id}
        renderItem={({ item }) => (
          <View style={styles.card}>
            <Text style={styles.nickname}>{item.nickname}</Text>
            <Text style={styles.region}>Регион: {item.region}</Text>
          </View>
        )}
      />
    </SafeAreaView>
  );
}

const styles = StyleSheet.create({
  container: { flex: 1, padding: 16, backgroundColor: '#fff' },
  title: { fontSize: 20, fontWeight: 'bold', marginBottom: 12 },
  input: { borderWidth: 1, padding: 8, marginBottom: 8, borderRadius: 8 },
  button: { backgroundColor: '#4f46e5', padding: 10, borderRadius: 8, marginBottom: 12 },
  buttonText: { color: '#fff', textAlign: 'center', fontWeight: '600' },
  card: { padding: 12, borderWidth: 1, borderRadius: 8, marginBottom: 8 },
  nickname: { fontSize: 16, fontWeight: '600' },
  region: { color: '#555' },
});
